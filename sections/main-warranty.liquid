{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'section-warranty.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign contact_page = pages['contact']
  assign contact_url = contact_page.url | default: '/pages/contact'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <article class="warranty-page{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <header class="warranty-page__header">
      <h1 class="main-page-title page-title h0">Vsling® No-Hassle Warranty</h1>
      <p>
        We stand behind every Vsling® we make. If your Vsling has a defect or fails due to materials or
        workmanship, <a href="{{ contact_url }}">contact us</a> and we’ll make it right—no hassle.
      </p>
    </header>

    <section class="warranty-page__section" aria-labelledby="WarrantyComfort-{{ section.id }}">
      <h2 id="WarrantyComfort-{{ section.id }}" class="h3">Made for Comfort</h2>
      <p>
        Vsling® is made from 100% elastic to provide a comfortable, flexible fit that keeps your bow
        secure while allowing you to move naturally.
      </p>
      <p>
        Like any elastic product, normal stretching and wear will occur over time. Lifespan will vary
        depending on frequency of use, conditions, and how the product is cared for.
      </p>
    </section>

    <section class="warranty-page__section" aria-labelledby="WarrantyCovered-{{ section.id }}">
      <h2 id="WarrantyCovered-{{ section.id }}" class="h3">What’s Covered</h2>
      <p>Manufacturing defects and premature failures caused by materials or workmanship.</p>
    </section>

    <section class="warranty-page__section" aria-labelledby="WarrantyNotCovered-{{ section.id }}">
      <h2 id="WarrantyNotCovered-{{ section.id }}" class="h3">What’s Not Covered</h2>
      <p>
        Normal wear and tear, gradual loss of elasticity, abrasion, fraying from use, cuts, misuse,
        modifications, accidents, or improper storage.
      </p>
    </section>

    <section class="warranty-page__section" aria-labelledby="WarrantyIssue-{{ section.id }}">
      <h2 id="WarrantyIssue-{{ section.id }}" class="h3">Have an Issue?</h2>
      <p>
        <a href="{{ contact_url }}">Contact us</a> with your order information, a photo of the product,
        and a brief description of the issue.
      </p>
      <p>If it’s a legitimate product problem, we’ll make it right—no hassle.</p>
    </section>
  </article>

  {% render 'breadcrumb-json-ld' %}
</div>

{% schema %}
{
  "name": "Warranty page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
